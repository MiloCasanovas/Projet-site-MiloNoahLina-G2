/*style des paragraphes*/
.p1{
  color :#BF7D65; ;
  font-family : Chancery;
  font-size : 16px;
  font-style : italic;
  font-weight : bold;
  text-align : left;
  text-decoration : none;
  line-height : 25px;
  text-indent : 20px;
  display: none;
  font-family : georgia,serif;
}
  
#soustitre{
  color : #D9D4BF;
}
/*style des titres*/
#h1{
  font-family : Liberation sans serif;
  font-size : 40px;
  font-weight : bold;
  text-align : left;
  text-decoration : none;
  line-height : 30px;
  color : #D9D4BF;
}

p{
  background-color:#0E1E32;
}
/*couleur de fond*/
body{
  background-color:#142B49; 
}
/*style des noms des vins*/
.titre {
  padding: 10px;
  background-color: #f0f0f0; 
  border: 1px solid #ccc;     
  margin: 10px 0;
  color : #D9D4BF;
  font-weight: bold;
  background-color:#0E1E32;
}
/*Quand le curseur est sur l'étoile*/
.rating {
  font-size: 24px;
  cursor: pointer;
}
/*Couleur de base de l'étoile*/
.star {
  color: #ccc;
  transition: color 0.3s;
}
/*quand l'étoile est survolée ou cliquée*/
.star.active,
.star:hover {
  color: gold;
}
    

